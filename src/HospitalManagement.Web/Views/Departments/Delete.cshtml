@model HospitalManagement.Application.DTOs.DepartmentDto
@{ ViewData["Title"] = "Delete Department"; }
<h2 class="text-danger mb-3">Delete Department</h2><div class="alert alert-warning">This permanently deletes the department. Departments assigned to doctors cannot be deleted.</div><p><strong>@Model.DepartmentCode</strong> — @Model.Name</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><button class="btn btn-danger">Delete Department</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
