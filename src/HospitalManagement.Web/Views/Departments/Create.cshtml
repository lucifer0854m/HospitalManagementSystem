@model HospitalManagement.Application.DTOs.CreateDepartmentDto
@{ ViewData["Title"] = "Add Department"; }
<h2 class="mb-4">Add Department</h2><form asp-action="Create" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="DepartmentCode" class="form-label"></label><input asp-for="DepartmentCode" class="form-control" /><span asp-validation-for="DepartmentCode" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div><div class="col-md-6 form-check align-self-end"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-12"><button class="btn btn-primary">Save Department</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
