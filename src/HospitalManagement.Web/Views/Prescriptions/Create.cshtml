@model HospitalManagement.Application.DTOs.CreatePrescriptionDto
@using HospitalManagement.Application.DTOs
@{ ViewData["Title"] = "New Prescription"; var medicines = (IEnumerable<MedicineDto>)ViewBag.Medicines; var appointments = (IEnumerable<AppointmentDto>)ViewBag.Appointments; var patients = (IEnumerable<PatientDto>)ViewBag.Patients; var doctors = (IEnumerable<DoctorDto>)ViewBag.Doctors; }

<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">New prescription</h1><p class="text-muted mb-0">Record the prescribed medicines and dosage.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to history</a></div>
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="card mb-4"><div class="card-body row g-3"><div class="col-md-4"><label asp-for="AppointmentId" class="form-label">Appointment</label><select asp-for="AppointmentId" class="form-select"><option value="">Select appointment</option>@foreach (var item in appointments) { <option value="@item.Id">@item.AppointmentNumber — @item.PatientName</option> }</select><span asp-validation-for="AppointmentId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="PatientId" class="form-label">Patient</label><select asp-for="PatientId" class="form-select"><option value="">Select patient</option>@foreach (var item in patients) { <option value="@item.Id">@item.PatientCode — @item.FullName</option> }</select><span asp-validation-for="PatientId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="DoctorId" class="form-label">Doctor</label><select asp-for="DoctorId" class="form-select"><option value="">Select doctor</option>@foreach (var item in doctors) { <option value="@item.Id">@item.DoctorCode — Dr. @item.FullName</option> }</select><span asp-validation-for="DoctorId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="PrescriptionDate" class="form-label">Prescription date</label><input asp-for="PrescriptionDate" type="date" class="form-control" /></div><div class="col-md-8"><label asp-for="Notes" class="form-label">Clinical notes</label><input asp-for="Notes" class="form-control" /></div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span>Medicines</span><button type="button" id="add-line" class="btn btn-sm btn-outline-primary">Add medicine</button></div><div class="card-body"><span asp-validation-for="Items" class="text-danger"></span><div id="lines">@for (var i = 0; i < Model.Items.Count; i++) { <div class="row g-2 align-items-end prescription-line mb-3"><div class="col-md-3"><label class="form-label">Medicine</label><select asp-for="Items[i].MedicineId" class="form-select"><option value="">Select medicine</option>@foreach (var medicine in medicines) { <option value="@medicine.Id">@medicine.MedicineName</option> }</select><span asp-validation-for="Items[i].MedicineId" class="text-danger"></span></div><div class="col-md-2"><label class="form-label">Dosage</label><input asp-for="Items[i].Dosage" class="form-control" /><span asp-validation-for="Items[i].Dosage" class="text-danger"></span></div><div class="col-md-2"><label class="form-label">Frequency</label><input asp-for="Items[i].Frequency" class="form-control" /><span asp-validation-for="Items[i].Frequency" class="text-danger"></span></div><div class="col-md-2"><label class="form-label">Days</label><input asp-for="Items[i].DurationInDays" class="form-control" /><span asp-validation-for="Items[i].DurationInDays" class="text-danger"></span></div><div class="col-md-2"><label class="form-label">Instructions</label><input asp-for="Items[i].Instructions" class="form-control" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-line">Remove</button></div></div> }</div><button type="submit" class="btn btn-primary">Save prescription</button></div></div></form>

<template id="line-template"><div class="row g-2 align-items-end prescription-line mb-3"><div class="col-md-3"><label class="form-label">Medicine</label><select name="Items[__INDEX__].MedicineId" class="form-select"><option value="">Select medicine</option>@foreach (var medicine in medicines) { <option value="@medicine.Id">@medicine.MedicineName</option> }</select></div><div class="col-md-2"><label class="form-label">Dosage</label><input name="Items[__INDEX__].Dosage" class="form-control" /></div><div class="col-md-2"><label class="form-label">Frequency</label><input name="Items[__INDEX__].Frequency" class="form-control" /></div><div class="col-md-2"><label class="form-label">Days</label><input name="Items[__INDEX__].DurationInDays" type="number" min="1" class="form-control" /></div><div class="col-md-2"><label class="form-label">Instructions</label><input name="Items[__INDEX__].Instructions" class="form-control" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-line">Remove</button></div></div></template>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>const lines = document.getElementById('lines'); const reindex = () => lines.querySelectorAll('.prescription-line').forEach((line, index) => line.querySelectorAll('[name]').forEach(field => field.name = field.name.replace(/Items\[\d+\]/, `Items[${index}]`))); document.getElementById('add-line').addEventListener('click', () => { const index = lines.querySelectorAll('.prescription-line').length; lines.insertAdjacentHTML('beforeend', document.getElementById('line-template').innerHTML.replaceAll('__INDEX__', index)); }); lines.addEventListener('click', event => { if (event.target.classList.contains('remove-line') && lines.querySelectorAll('.prescription-line').length > 1) { event.target.closest('.prescription-line').remove(); reindex(); } });</script> }
