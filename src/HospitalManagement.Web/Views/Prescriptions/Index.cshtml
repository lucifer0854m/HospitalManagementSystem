@model IEnumerable<HospitalManagement.Application.DTOs.PrescriptionListDto>
@{ ViewData["Title"] = "Prescriptions"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Prescription history</h1><p class="text-muted mb-0">Review prescriptions issued to patients.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-file-earmark-plus"></i> New prescription</a>
</div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Date</th><th>Appointment</th><th>Patient</th><th>Doctor</th><th>Medicines</th><th></th></tr></thead>
    <tbody>
    @foreach (var prescription in Model)
    {
        <tr><td>@prescription.PrescriptionDate.ToString("dd MMM yyyy")</td><td>@prescription.AppointmentNumber</td><td>@prescription.PatientName</td><td>@prescription.DoctorName</td><td>@prescription.ItemCount</td><td><a asp-action="Details" asp-route-id="@prescription.Id" class="btn btn-sm btn-outline-primary">View</a></td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No prescriptions have been recorded.</td></tr> }
    </tbody>
</table></div></div>
