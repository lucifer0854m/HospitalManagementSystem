@model HospitalManagement.Application.DTOs.PrescriptionDetailsDto
@{ ViewData["Title"] = "Prescription Details"; }

<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Prescription</h1><p class="text-muted mb-0">Issued @Model.PrescriptionDate.ToString("dd MMM yyyy")</p></div><div><a asp-action="Create" class="btn btn-primary">New prescription</a> <a asp-action="Index" class="btn btn-outline-secondary">Back to history</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted d-block">Patient</small><strong>@Model.PatientName</strong></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted d-block">Doctor</small><strong>@Model.DoctorName</strong></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted d-block">Appointment</small><strong>@Model.AppointmentNumber</strong></div></div></div></div>
<div class="card mb-4"><div class="card-header">Medicines</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Instructions</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.MedicineName</td><td>@item.Dosage</td><td>@item.Frequency</td><td>@item.DurationInDays day(s)</td><td>@item.Instructions</td></tr> }</tbody></table></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="card"><div class="card-header">Clinical notes</div><div class="card-body">@Model.Notes</div></div> }
