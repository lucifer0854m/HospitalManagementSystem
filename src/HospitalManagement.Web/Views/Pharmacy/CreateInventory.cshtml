@model HospitalManagement.Application.DTOs.SaveInventoryDto
@{ ViewData["Title"] ??= "Add inventory"; var formAction = ViewData["FormAction"]?.ToString() ?? "CreateInventory"; }
<h1 class="h3 mb-4">@ViewData["Title"]</h1><form action="@Url.Action(formAction, new { id = Context.Request.Query["id"] })" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="MedicineId" class="form-label">Medicine</label><select asp-for="MedicineId" class="form-select"><option value="">Select medicine</option>@foreach(var medicine in ViewBag.Medicines) { <option value="@medicine.Id">@medicine.MedicineName</option> }</select></div><div class="col-md-3"><label asp-for="AvailableQuantity" class="form-label"></label><input asp-for="AvailableQuantity" class="form-control" /></div><div class="col-md-3"><label asp-for="ReorderLevel" class="form-label"></label><input asp-for="ReorderLevel" class="form-control" /></div><div class="col-md-4"><label asp-for="BatchNumber" class="form-label"></label><input asp-for="BatchNumber" class="form-control" /></div><div class="col-md-4"><label asp-for="ExpiryDate" class="form-label"></label><input asp-for="ExpiryDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="SupplierName" class="form-label"></label><input asp-for="SupplierName" class="form-control" /></div><div class="col-12"><button class="btn btn-primary">Save inventory</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
