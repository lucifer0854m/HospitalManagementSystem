@model HospitalManagement.Application.DTOs.SaveMedicineDto
@{ ViewData["Title"] = "Add medicine"; }
<h1 class="h3 mb-4">Add medicine</h1><form asp-action="CreateMedicine" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-4"><label asp-for="MedicineCode" class="form-label"></label><input asp-for="MedicineCode" class="form-control" /><span asp-validation-for="MedicineCode" class="text-danger"></span></div><div class="col-md-8"><label asp-for="MedicineName" class="form-label"></label><input asp-for="MedicineName" class="form-control" /><span asp-validation-for="MedicineName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="GenericName" class="form-label"></label><input asp-for="GenericName" class="form-control" /></div><div class="col-md-4"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control" /></div><div class="col-md-2"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" placeholder="Tablet" /></div><div class="col-md-2"><label asp-for="UnitPrice" class="form-label"></label><input asp-for="UnitPrice" class="form-control" /></div><div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div><div class="col-12"><button class="btn btn-primary">Save medicine</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
