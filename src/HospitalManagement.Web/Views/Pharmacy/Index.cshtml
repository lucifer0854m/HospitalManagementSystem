@model HospitalManagement.Web.Models.PharmacyIndexViewModel
@{ ViewData["Title"] = "Pharmacy"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Pharmacy & inventory</h1><p class="text-muted mb-0">Manage medicines, batches, and reorder levels.</p></div><div><a asp-action="CreateMedicine" class="btn btn-primary">Add medicine</a> <a asp-action="CreateInventory" class="btn btn-outline-primary">Add inventory</a></div></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (Model.LowStock.Any()) { <div class="alert alert-warning"><strong>Low stock:</strong> @string.Join(", ", Model.LowStock.Select(x => x.MedicineName))</div> }
<div class="card mb-4"><div class="card-header">Medicines</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Name</th><th>Generic name</th><th>Manufacturer</th><th>Unit price</th><th>Status</th></tr></thead><tbody>@foreach(var medicine in Model.Medicines) { <tr><td>@medicine.MedicineCode</td><td>@medicine.MedicineName</td><td>@medicine.GenericName</td><td>@medicine.Manufacturer</td><td>@medicine.UnitPrice.ToString("N2") / @medicine.Unit</td><td>@(medicine.IsActive ? "Active" : "Inactive")</td></tr> }</tbody></table></div></div>
<div class="card"><div class="card-header">Inventory</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Medicine</th><th>Batch</th><th>Available</th><th>Reorder at</th><th>Expiry</th><th>Supplier</th></tr></thead><tbody>@foreach(var item in Model.Inventory) { <tr class="@(item.AvailableQuantity <= item.ReorderLevel ? "table-warning" : "")"><td>@item.MedicineName</td><td>@item.BatchNumber</td><td>@item.AvailableQuantity</td><td>@item.ReorderLevel</td><td>@item.ExpiryDate?.ToString("dd MMM yyyy")</td><td>@item.SupplierName</td></tr> }</tbody></table></div></div>
