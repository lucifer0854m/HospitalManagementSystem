@model HospitalManagement.Application.DTOs.SaveLabTestDto
@{ ViewData["Title"] ??= "Add lab test"; var formAction = ViewData["FormAction"]?.ToString() ?? "CreateTest"; }
<h1 class="h3 mb-4">@ViewData["Title"]</h1><form action="@Url.Action(formAction, new { id = Context.Request.Query["id"] })" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-4"><label asp-for="TestCode" class="form-label"></label><input asp-for="TestCode" class="form-control" /></div><div class="col-md-8"><label asp-for="TestName" class="form-label"></label><input asp-for="TestName" class="form-control" /></div><div class="col-md-4"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /></div><div class="col-md-4"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /></div><div class="col-md-4"><label asp-for="NormalRange" class="form-label">Normal range</label><input asp-for="NormalRange" class="form-control" /></div><div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div><div class="col-12"><button class="btn btn-primary">Save test</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
