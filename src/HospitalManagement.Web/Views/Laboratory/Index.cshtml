@model HospitalManagement.Web.Models.LaboratoryIndexViewModel
@{ ViewData["Title"] = "Laboratory"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Laboratory</h1><p class="text-muted mb-0">Manage tests, patient requests, and results.</p></div><div><a asp-action="CreateTest" class="btn btn-outline-primary">Add test</a> <a asp-action="CreateRequest" class="btn btn-primary">New request</a> <a asp-action="RecordResult" class="btn btn-success">Record result</a></div></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card mb-4"><div class="card-header">Laboratory tests</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Test</th><th>Category</th><th>Price</th><th>Normal range</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var test in Model.Tests) { <tr><td>@test.TestCode</td><td>@test.TestName</td><td>@test.Category</td><td>@test.Price.ToString("N2")</td><td>@test.NormalRange</td><td>@(test.IsActive ? "Active" : "Inactive")</td><td><a asp-action="EditTest" asp-route-id="@test.Id" class="btn btn-sm btn-outline-primary">Edit</a></td></tr> }</tbody></table></div></div>
<div class="card"><div class="card-header">Lab requests</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Request</th><th>Patient</th><th>Test</th><th>Requested</th><th>Status</th></tr></thead><tbody>@foreach(var request in Model.Requests) { <tr><td>@request.RequestNumber</td><td>@request.PatientName</td><td>@request.TestName</td><td>@request.RequestedOn.ToString("dd MMM yyyy HH:mm")</td><td>@request.Status</td></tr> }</tbody></table></div></div>
