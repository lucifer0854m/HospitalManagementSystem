@model HospitalManagement.Application.DTOs.RecordLabResultDto
@{ ViewData["Title"] = "Record lab result"; }
<h1 class="h3 mb-4">Record laboratory result</h1><form asp-action="RecordResult" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-8"><label asp-for="LabRequestId" class="form-label">Lab request</label><select asp-for="LabRequestId" class="form-select"><option value="">Select request</option>@foreach(var request in ViewBag.Requests) { if (request.Status.ToString() != "Completed") { <option value="@request.Id">@request.RequestNumber — @request.PatientName — @request.TestName (@request.Status)</option> } }</select></div><div class="col-md-12"><label asp-for="ResultValue" class="form-label">Result</label><textarea asp-for="ResultValue" class="form-control" rows="3"></textarea></div><div class="col-md-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea></div><div class="col-12"><button class="btn btn-success">Record result</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
