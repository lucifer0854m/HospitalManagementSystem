@model HospitalManagement.Application.DTOs.CreateLabRequestDto
@{ ViewData["Title"] = "New lab request"; }
<h1 class="h3 mb-4">New laboratory request</h1><form asp-action="CreateRequest" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-4"><label asp-for="RequestNumber" class="form-label"></label><input asp-for="RequestNumber" class="form-control" /></div><div class="col-md-4"><label asp-for="LabTestId" class="form-label">Test</label><select asp-for="LabTestId" class="form-select"><option value="">Select test</option>@foreach(var test in ViewBag.Tests) { <option value="@test.Id">@test.TestName</option> }</select></div><div class="col-md-4"><label asp-for="PatientId" class="form-label">Patient</label><select asp-for="PatientId" class="form-select"><option value="">Select patient</option>@foreach(var patient in ViewBag.Patients) { <option value="@patient.Id">@patient.FullName</option> }</select></div><div class="col-md-6"><label asp-for="DoctorId" class="form-label">Doctor (optional)</label><select asp-for="DoctorId" class="form-select"><option value="">None</option>@foreach(var doctor in ViewBag.Doctors) { <option value="@doctor.Id">@doctor.FullName</option> }</select></div><div class="col-md-6"><label asp-for="AppointmentId" class="form-label">Appointment (optional)</label><select asp-for="AppointmentId" class="form-select"><option value="">None</option>@foreach(var appointment in ViewBag.Appointments) { <option value="@appointment.Id">@appointment.AppointmentNumber — @appointment.PatientName</option> }</select></div><div class="col-12"><button class="btn btn-primary">Create request</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
