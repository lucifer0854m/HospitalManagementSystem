@model List<(HospitalManagement.Infrastructure.Identity.ApplicationUser User, IList<string> Roles)>
@{ ViewData["Title"] = "Users"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Users</h1><a asp-action="Create" class="btn btn-primary">Add user</a></div>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.User.DisplayName</td><td>@item.User.Email</td><td>@string.Join(", ", item.Roles)</td></tr> }</tbody></table>
