@model HospitalManagement.Application.DTOs.AppointmentDto
@{ ViewData["Title"] = "Appointment Details"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0">@Model.AppointmentNumber</h2><div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<dl class="row"><dt class="col-sm-3">Patient</dt><dd class="col-sm-9">@Model.PatientName</dd><dt class="col-sm-3">Doctor</dt><dd class="col-sm-9">Dr. @Model.DoctorName</dd><dt class="col-sm-3">Date & Time</dt><dd class="col-sm-9">@Model.AppointmentDate.ToString("dd MMM yyyy") @Model.AppointmentTime.ToString("hh\\:mm")</dd><dt class="col-sm-3">Type / Status</dt><dd class="col-sm-9">@Model.AppointmentType / @Model.Status</dd><dt class="col-sm-3">Reason</dt><dd class="col-sm-9">@Model.Reason</dd><dt class="col-sm-3">Symptoms</dt><dd class="col-sm-9">@Model.Symptoms</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl>
