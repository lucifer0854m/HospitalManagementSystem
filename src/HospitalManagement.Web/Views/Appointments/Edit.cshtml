@model HospitalManagement.Application.DTOs.UpdateAppointmentDto
@using HospitalManagement.Domain.Enums
@{ ViewData["Title"] = "Edit Appointment"; }
<h2 class="mb-4">Edit Appointment</h2><form asp-action="Edit" method="post" class="row g-3"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-4"><label asp-for="AppointmentNumber" class="form-label"></label><input asp-for="AppointmentNumber" class="form-control" /></div><div class="col-md-4"><label asp-for="PatientId" class="form-label">Patient</label><select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select"></select></div><div class="col-md-4"><label asp-for="DoctorId" class="form-label">Doctor</label><select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select"></select></div>
<div class="col-md-4"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="AppointmentTime" class="form-label"></label><input asp-for="AppointmentTime" type="time" class="form-control" /></div><div class="col-md-4"><label asp-for="AppointmentType" class="form-label"></label><select asp-for="AppointmentType" asp-items="Html.GetEnumSelectList<AppointmentType>()" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select"></select></div><div class="col-md-8"><label asp-for="Reason" class="form-label"></label><input asp-for="Reason" class="form-control" /></div><div class="col-md-6"><label asp-for="Symptoms" class="form-label"></label><input asp-for="Symptoms" class="form-control" /></div><div class="col-md-6"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div><div class="col-md-6"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control" /></div><div class="col-md-6 form-check align-self-end"><input asp-for="IsFollowUp" class="form-check-input" /><label asp-for="IsFollowUp" class="form-check-label"></label></div><div class="col-12"><button class="btn btn-primary">Save Changes</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
