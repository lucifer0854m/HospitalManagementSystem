@model HospitalManagement.Web.Models.BillingIndexViewModel
@using HospitalManagement.Domain.Enums
@{ ViewData["Title"] = "Billing"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Billing</h1><p class="text-muted mb-0">Create bills and record payments.</p></div></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-4"><div class="col-lg-7"><div class="card"><div class="card-header">New bill</div><div class="card-body"><form asp-action="Create" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-4"><label asp-for="NewBill.BillNumber" class="form-label">Bill number</label><input asp-for="NewBill.BillNumber" name="BillNumber" class="form-control" /></div><div class="col-md-4"><label asp-for="NewBill.PatientId" class="form-label">Patient</label><select asp-for="NewBill.PatientId" name="PatientId" class="form-select"><option value="">Select patient</option>@foreach (var patient in ViewBag.Patients) { <option value="@patient.Id">@patient.FullName</option> }</select></div><div class="col-md-4"><label asp-for="NewBill.AppointmentId" class="form-label">Appointment</label><select asp-for="NewBill.AppointmentId" name="AppointmentId" class="form-select"><option value="">None</option>@foreach (var appointment in ViewBag.Appointments) { <option value="@appointment.Id">@appointment.AppointmentNumber — @appointment.PatientName</option> }</select></div>
<div class="col-md-4"><label asp-for="NewBill.BillDate" class="form-label">Bill date</label><input asp-for="NewBill.BillDate" name="BillDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="NewBill.Discount" class="form-label">Discount</label><input asp-for="NewBill.Discount" name="Discount" class="form-control" /></div><div class="col-md-4"><label asp-for="NewBill.TaxAmount" class="form-label">Tax amount</label><input asp-for="NewBill.TaxAmount" name="TaxAmount" class="form-control" /></div>
<div class="col-12"><div class="d-flex justify-content-between align-items-center mb-2"><label class="form-label mb-0">Bill items</label><button id="add-bill-item" type="button" class="btn btn-sm btn-outline-primary">Add item</button></div><div id="bill-items"><div class="row g-2 bill-item mb-2"><div class="col-md-5"><input asp-for="NewBill.Items[0].ItemName" name="Items[0].ItemName" class="form-control" placeholder="Item or service" /></div><div class="col-md-2"><input asp-for="NewBill.Items[0].Quantity" name="Items[0].Quantity" type="number" min="1" class="form-control" placeholder="Quantity" /></div><div class="col-md-3"><input asp-for="NewBill.Items[0].UnitPrice" name="Items[0].UnitPrice" type="number" min="0" step="0.01" class="form-control" placeholder="Unit price" /></div><div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-bill-item">Remove</button></div></div></div><span asp-validation-for="NewBill.Items" class="text-danger"></span></div><div class="col-12"><button class="btn btn-primary">Create bill</button></div></form></div></div></div>
<div class="col-lg-5"><div class="card"><div class="card-header">Record payment</div><div class="card-body"><form asp-action="RecordPayment" method="post" class="row g-3"><div class="col-12"><label class="form-label">Bill</label><select name="BillId" class="form-select"><option value="">Select bill</option>@foreach(var bill in Model.Bills.Where(x => x.Balance > 0)) { <option value="@bill.Id">@bill.BillNumber — @bill.PatientName (balance @bill.Balance.ToString("N2"))</option> }</select></div><div class="col-md-6"><label class="form-label">Amount</label><input name="Amount" type="number" min="0.01" step="0.01" class="form-control" /></div><div class="col-md-6"><label class="form-label">Date</label><input name="PaymentDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-12"><label class="form-label">Method</label><select name="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select></div><div class="col-12"><label class="form-label">Reference</label><input name="TransactionReference" class="form-control" /></div><div class="col-12"><button class="btn btn-success">Record payment</button></div></form></div></div></div></div>
<div class="card mt-4"><div class="card-header">Bills</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bill</th><th>Patient</th><th>Date</th><th>Net</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody>@foreach(var bill in Model.Bills) { <tr><td>@bill.BillNumber</td><td>@bill.PatientName</td><td>@bill.BillDate.ToString("dd MMM yyyy")</td><td>@bill.NetAmount.ToString("N2")</td><td>@bill.PaidAmount.ToString("N2")</td><td>@bill.Balance.ToString("N2")</td><td>@bill.PaymentStatus</td></tr> }</tbody></table></div></div>
<template id="bill-item-template"><div class="row g-2 bill-item mb-2"><div class="col-md-5"><input name="Items[__INDEX__].ItemName" class="form-control" placeholder="Item or service" /></div><div class="col-md-2"><input name="Items[__INDEX__].Quantity" type="number" min="1" class="form-control" placeholder="Quantity" /></div><div class="col-md-3"><input name="Items[__INDEX__].UnitPrice" type="number" min="0" step="0.01" class="form-control" placeholder="Unit price" /></div><div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-bill-item">Remove</button></div></div></template>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>const billItems = document.getElementById('bill-items'); const reindexBillItems = () => billItems.querySelectorAll('.bill-item').forEach((row, index) => row.querySelectorAll('[name]').forEach(field => field.name = field.name.replace(/Items\[\d+\]/, `Items[${index}]`))); document.getElementById('add-bill-item').addEventListener('click', () => { const index = billItems.querySelectorAll('.bill-item').length; billItems.insertAdjacentHTML('beforeend', document.getElementById('bill-item-template').innerHTML.replaceAll('__INDEX__', index)); }); billItems.addEventListener('click', event => { if (event.target.classList.contains('remove-bill-item') && billItems.querySelectorAll('.bill-item').length > 1) { event.target.closest('.bill-item').remove(); reindexBillItems(); } });</script> }
