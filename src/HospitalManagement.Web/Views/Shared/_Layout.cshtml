<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Management System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagement.Web.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    🏥 Hospital Management
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbar">

                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Dashboard</a></li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor") || User.IsInRole("Receptionist"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Patients" asp-action="Index"><i class="bi bi-person"></i> Patients</a></li> }
                        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Departments" asp-action="Index"><i class="bi bi-building"></i> Departments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="Index"><i class="bi bi-heart-pulse"></i> Doctors</a></li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor") || User.IsInRole("Receptionist"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i> Appointments</a></li> }
                        @if (User.IsInRole("Admin"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports</a></li> }
                        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Billing" asp-action="Index"><i class="bi bi-receipt"></i> Billing</a></li> }
                        @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Pharmacy" asp-action="Index"><i class="bi bi-capsule"></i> Pharmacy</a></li> }
                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor") || User.IsInRole("LabTechnician"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Laboratory" asp-action="Index"><i class="bi bi-virus"></i> Laboratory</a></li> }
                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                        { <li class="nav-item"><a class="nav-link" asp-controller="Prescriptions" asp-action="Index"><i class="bi bi-file-earmark-medical"></i> Prescriptions</a></li> }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            { <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a></li> }
                            <li class="nav-item"><span class="navbar-text me-2">@User.Identity.Name</span></li>
                            <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-link nav-link" type="submit">Sign out</button></form></li>
                        }
                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <div class="container mt-4">

        @RenderBody()

    </div>

    <footer class="border-top mt-5">

        <div class="container py-3 text-center text-muted">

            © 2026 Hospital Management System

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
