<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Management System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagement.Web.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    🏥 Hospital Management
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house"></i>
                                Dashboard

                            </a>
                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Patients"
                               asp-action="Index">

                                <i class="bi bi-person"></i>
                                Patients

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Departments"
                               asp-action="Index">

                                <i class="bi bi-building"></i>
                                Departments

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Doctors"
                               asp-action="Index">

                                <i class="bi bi-heart-pulse"></i>
                                Doctors

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Appointments"
                               asp-action="Index">

                                <i class="bi bi-calendar-check"></i>
                                Appointments

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Billing"
                               asp-action="Index">

                                <i class="bi bi-receipt"></i>
                                Billing

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Reports"
                               asp-action="Index">

                                <i class="bi bi-bar-chart"></i>
                                Reports

                            </a>

                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <div class="container mt-4">

        @RenderBody()

    </div>

    <footer class="border-top mt-5">

        <div class="container py-3 text-center text-muted">

            © 2026 Hospital Management System

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
