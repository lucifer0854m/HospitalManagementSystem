@model HospitalManagement.Application.DTOs.DoctorDto
@{ ViewData["Title"] = "Delete Doctor"; }
<h2 class="text-danger mb-3">Delete Doctor</h2><div class="alert alert-warning">This permanently deletes the doctor record.</div>
<p><strong>@Model.DoctorCode</strong> — Dr. @Model.FullName (@Model.Specialization)</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Delete Doctor</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
