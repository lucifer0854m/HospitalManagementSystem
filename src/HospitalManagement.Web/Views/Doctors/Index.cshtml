@model IEnumerable<HospitalManagement.Application.DTOs.DoctorDto>
@{ ViewData["Title"] = "Doctors"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0">Doctors</h2><a asp-action="Create" class="btn btn-primary">Add Doctor</a></div>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<table class="table table-bordered table-hover"><thead class="table-primary"><tr><th>Code</th><th>Name</th><th>Specialization</th><th>Department</th><th>Mobile</th><th>Available</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.DoctorCode</td><td>@item.FullName</td><td>@item.Specialization</td><td>@item.DepartmentName</td><td>@item.MobileNumber</td><td>@(item.IsAvailable ? "Yes" : "No")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
</tbody></table>
