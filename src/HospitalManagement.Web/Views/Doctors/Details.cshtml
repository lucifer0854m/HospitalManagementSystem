@model HospitalManagement.Application.DTOs.DoctorDto
@{ ViewData["Title"] = "Doctor Details"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0">Dr. @Model.FullName</h2><div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<dl class="row"><dt class="col-sm-3">Doctor Code</dt><dd class="col-sm-9">@Model.DoctorCode</dd><dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.DepartmentName</dd><dt class="col-sm-3">Specialization</dt><dd class="col-sm-9">@Model.Specialization</dd><dt class="col-sm-3">Qualification</dt><dd class="col-sm-9">@Model.Qualification</dd><dt class="col-sm-3">Experience</dt><dd class="col-sm-9">@Model.ExperienceInYears years</dd><dt class="col-sm-3">Consultation Fee</dt><dd class="col-sm-9">@Model.ConsultationFee</dd><dt class="col-sm-3">Mobile / Email</dt><dd class="col-sm-9">@Model.MobileNumber / @Model.Email</dd><dt class="col-sm-3">Availability</dt><dd class="col-sm-9">@(Model.IsAvailable ? "Available" : "Unavailable")</dd></dl>
