@model HospitalManagement.Application.DTOs.PatientDto
@{
    ViewData["Title"] = "Patient Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">@Model.FullName</h2>
    <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
</div>

<dl class="row">
    <dt class="col-sm-3">Patient Code</dt><dd class="col-sm-9">@Model.PatientCode</dd>
    <dt class="col-sm-3">Date of Birth</dt><dd class="col-sm-9">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Gender / Blood Group</dt><dd class="col-sm-9">@Model.Gender / @Model.BloodGroup</dd>
    <dt class="col-sm-3">Mobile / Email</dt><dd class="col-sm-9">@Model.MobileNumber @(string.IsNullOrWhiteSpace(Model.Email) ? "" : $"/ {Model.Email}")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.State, @Model.Country - @Model.Pincode</dd>
    <dt class="col-sm-3">Emergency Contact</dt><dd class="col-sm-9">@Model.EmergencyContactName (@Model.EmergencyContactRelation) - @Model.EmergencyContactNumber</dd>
    <dt class="col-sm-3">Height / Weight</dt><dd class="col-sm-9">@Model.Height cm / @Model.Weight kg</dd>
    <dt class="col-sm-3">Allergies</dt><dd class="col-sm-9">@Model.Allergies</dd>
    <dt class="col-sm-3">Medical History</dt><dd class="col-sm-9">@Model.MedicalHistory</dd>
</dl>
