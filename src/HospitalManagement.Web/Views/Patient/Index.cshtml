@model IEnumerable<HospitalManagement.Application.DTOs.PatientDto>

@{
    ViewData["Title"] = "Patients";
}

<h2 class="mb-4">Patients</h2>

<table class="table table-bordered table-hover">
    <thead class="table-primary">
        <tr>
            <th>Patient Code</th>
            <th>Name</th>
            <th>Gender</th>
            <th>Mobile</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PatientCode</td>
                <td>@item.FullName</td>
                <td>@item.Gender</td>
                <td>@item.MobileNumber</td>
                <td>@item.Status</td>
            </tr>
        }

    </tbody>
</table>